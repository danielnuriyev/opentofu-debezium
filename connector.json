{
  "name": "mongodb-local-test",
  "config": {
    "connector.class": "io.debezium.connector.mongodb.MongoDbConnector",
    "tasks.max": "1",
    "mongodb.connection.string": "mongodb://root:example@mongodb.mongodb.svc.cluster.local:27017/?authSource=admin&replicaSet=rs0&retryWrites=false",
    "topic.prefix": "mongo",
    "database.include.list": "dev",
    "collection.include.list": "dev.test",
    "capture.mode": "change_streams_update_full",
    "snapshot.mode": "initial",
    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": ".*",
    "transforms.route.replacement": "test"
  }
}
